{
  "name": "photo-competitions",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs",
    "dev": "vite",
    "build": "vite build",
    "prepreview": "node scripts/ensure-dev-vars.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply photo-competitions-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply photo-competitions-db --remote",
    "deploy": "vite build && wrangler deploy",
    "test": "playwright test"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
